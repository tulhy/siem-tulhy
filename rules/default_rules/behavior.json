[
  {
    "id": "TEMP_EXECUTION",
    "name": "Execução a partir de diretório temporário",
    "description": "Processo executado em diretório temporário ou de downloads. Instaladores legítimos também podem gerar este alerta.",
    "category": "execution",
    "severity": "MEDIUM",
    "confidence": "LOW",
    "conditions": [
      {
        "field": "event_type",
        "value": "process.start"
      },
      {
        "field": "process.path",
        "op": "contains_any",
        "value": [
          "\\temp\\",
          "/tmp/",
          "\\downloads\\"
        ]
      }
    ],
    "tags": [
      "behavior"
    ],
    "mitre": [
      "T1204.002"
    ]
  },
  {
    "id": "FILE_CHANGE",
