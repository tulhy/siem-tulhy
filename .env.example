# Docker Compose loads .env. Python/uvicorn do not automatically load it.
# Generate each secret separately: python -c "import secrets; print(secrets.token_hex(32))"
SIEM_ADMIN_TOKEN=
POSTGRES_PASSWORD=
SIEM_DOMAIN=siem.example.com
ACME_EMAIL=admin@example.com
SIEM_HEARTBEAT_TIMEOUT=120
# Direct local execution (set environment variables explicitly):
DATABASE_URL=sqlite:///data/server.db
SIEM_SERVER_URL=https://localhost:8443
SIEM_AGENT_ID=
SIEM_AGENT_TOKEN=
# Optional custom CA bundle for laboratory HTTPS. TLS verification stays enabled.
SIEM_CA_BUNDLE=
SIEM_AGENT_CONFIG=config.yaml
